# PostgreSQL 18 administrator: used ONLY by explicit database preparation/tests.
# Use a dedicated local instance; the port/name guards intentionally protect other databases.
ITPW_ADMIN_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:55432/postgres
# Leave blank to use the restricted application account generated by prepare.
ITPM_DATABASE_URL=
ITPM_PROFILE=preview
ITPM_INTEGRATION_MODE=fake
ITPM_PUBLIC_BASE=/pm/
ITPW_API_PORT=8084
ITPW_UI_PORT=3004
ITPW_PUBLIC_URL=http://127.0.0.1:3004/pm/
# Only needed for explicitly configured external integrations; do not commit credentials.
ITPM_DINGTALK_APP_KEY=
ITPM_DINGTALK_APP_SECRET=
